// Deploy config for the fatsecret-proxy Worker. Builds deploy command:
//   npx wrangler deploy -c wrangler.fatsecret.jsonc
// Secrets FATSECRET_CLIENT_ID, FATSECRET_CLIENT_SECRET and PROXY_TOKEN stay in the dashboard; never put them here.
{
  "name": "fatsecret-proxy",
  "main": "worker/fatsecret-proxy.js",
  "compatibility_date": "2026-11-01",
  "keep_vars": true
}
